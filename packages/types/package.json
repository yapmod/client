{
  "name": "@yapmod/types",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yapmod/client.git",
    "directory": "packages/types"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./yapmod.d.ts": {
      "types": "./dist/yapmod.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && cp src/yapmod.d.ts dist/yapmod.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "solid-js": "^1.9.18",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "solid-js": "^1.9.18"
  }
}

{
  "name": "@yapmod/types",
  "version": "1.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yapmod/client.git",
    "directory": "packages/types"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./plugin-env": {
      "types": "./dist/plugin-env/yapmod.d.ts",
      "import": "./dist/plugin-env/index.js",
      "default": "./src/plugin-env/index.ts"
    },
    "./client-env": {
      "types": "./dist/client-env/yapmod-client.d.ts",
      "import": "./dist/client-env/index.js",
      "default": "./src/client-env/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-declarations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:contracts": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "solid-js": "^1.9.18",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "solid-js": "^1.9.18"
  }
}

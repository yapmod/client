{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "d68139dc41b408c5dcdeadc602c9acedef40ae8f",
  "release-type": "manual-node",
  "draft": true,
  "force-tag-creation": true,
  "separate-pull-requests": false,
  "packages": {
    ".": {
      "component": "client",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": ["apps/docs", "packages/builder"],
      "extra-files": [
        {
          "type": "json",
          "path": "apps/client/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "packages/builder": {
      "component": "builder"
    },
    "packages/types": {
      "component": "types"
    }
  }
}
